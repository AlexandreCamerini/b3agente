# Fonte unica VERSIONADA da versao iOS (web/ios/ e gitignored e recriavel).
# Lido por parse (grep/sed) por scripts/ios-aplicar-projeto.sh e
# scripts/ios-bump-build.sh - NUNCA por `source`.
#
# MARKETING_VERSION: versao PUBLICA (a que o usuario ve na App Store). Sobe
#   junto com o `version` dos package.json (raiz/web/web-admin), na cadencia
#   que o Alex decidir. Edicao MANUAL: nenhum script altera package.json nem
#   le um do outro.
# CURRENT_PROJECT_VERSION: ultimo build enviado ao App Store Connect. So
#   scripts/ios-bump-build.sh incrementa; o valor commitado deve ser o do
#   ultimo upload (commite este arquivo junto do archive).
#
# Nenhum dos dois tem relacao com BUILD_ID/SERVER_BUILD_ID nem com tag git
# (tres esquemas de versao, tres cadencias - ver CLAUDE.md).
MARKETING_VERSION=2.0
CURRENT_PROJECT_VERSION=35
